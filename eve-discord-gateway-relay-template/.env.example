# The app-scoped Connect connector created by `eve add channel/discord`.
# This also provides the stable identity for Discord event delivery.
DISCORD_CONNECTOR=

# Enable only after turning on the privileged intent in Discord's Developer Portal.
DISCORD_MESSAGE_CONTENT_INTENT=false

# Generate independently with: openssl rand -hex 32
CRON_SECRET=
RELAY_SECRET=
RELAY_FORWARD_SECRET=

# Keep below the Function limit. Defaults to 10 minutes and is capped at 12 minutes.
RELAY_RUN_MS=600000
